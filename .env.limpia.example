# Stack efimero de instalacion limpia (proyecto de compose "mtabolic-limpia", D7-OP-01):
# base vacia, volumen, red e imagenes propios; libros historicos REALES montados de solo
# lectura. No toca el stack principal ni el e2e. Se borra al terminar.
# Copiar a .env.limpia (no versionado) y reemplazar cada marcador por una contrasena nueva
# (URL-safe, p. ej. hex; distintas entre si y de las del principal). Nunca valores reales aqui.
#
# Levantar:  docker compose -p mtabolic-limpia --env-file .env.limpia up -d --build
# Estado:    curl http://localhost:8082/api/v1/sistema/estado   (espera LISTO; via nginx: el
#            puerto 8002 del backend responde 403 al host salvo /api/v1/health, CU-00)
# App:       http://localhost:8082
# Bajar:     docker compose -p mtabolic-limpia --env-file .env.limpia down -v
#            (-v borra solo el volumen mtabolic-limpia_pgdata; SIEMPRE con -p mtabolic-limpia)
#            y despues borra .env.limpia.
# Ojo: las variables exportadas en la shell ganan a --env-file. Lanza este stack desde una
# shell SIN el .env principal cargado (sin `set -a; . ./.env`).

# --- PostgreSQL ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASENA_DE_LA_INSTALACION_LIMPIA
POSTGRES_DB=app_db_limpia

# --- Rol de la aplicacion sin superusuario (S23 activo; ver .env.example) ---
APP_DB_USER=mtabolic_app
APP_DB_PASSWORD=CAMBIAR_POR_CONTRASENA_DEL_ROL_DE_LA_APP
MIGRATE_DATABASE_URL=postgresql+psycopg://app_user:CAMBIAR_POR_CONTRASENA_DE_LA_INSTALACION_LIMPIA@db:5432/app_db_limpia

# --- Backend (con el rol de la aplicacion) ---
DATABASE_URL=postgresql+psycopg://mtabolic_app:CAMBIAR_POR_CONTRASENA_DEL_ROL_DE_LA_APP@db:5432/app_db_limpia
CORS_ORIGINS=http://localhost:8082
APP_ENV=development

# --- Libros historicos REALES (relativo a compose.yaml; carpeta no versionada) ---
HISTORICO_DIR=./plantillas

# --- Puertos e imagenes propios del stack limpio ---
DB_PORT=5434
BACKEND_PORT=8002
FRONTEND_PORT=8082
IMAGE_TAG=limpia

# --- Red interna e IPs permitidas (explicitas: no chocan con el principal ni con el e2e) ---
RED_INTERNA_SUBNET=172.31.0.0/24
FRONTEND_IP=172.31.0.10
IPS_PERMITIDAS=127.0.0.1,::1,172.31.0.10
