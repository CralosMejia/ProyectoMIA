# Plantilla de variables de entorno. Copiar a .env (no versionado) y reemplazar
# cada valor marcador por uno local. Nunca poner valores reales en este archivo.
# La contrasena debe ser URL-safe (p. ej. hex) porque se inserta en las URLs.

# --- PostgreSQL (servicio db de compose) ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASENA_LOCAL
POSTGRES_DB=app_db

# --- Backend ---
# Dentro de la red de compose el host de la BD es "db".
DATABASE_URL=postgresql+psycopg://app_user:CAMBIAR_POR_CONTRASENA_LOCAL@db:5432/app_db
# Origenes CORS explicitos separados por coma (el comodin esta prohibido).
CORS_ORIGINS=http://localhost:8080
# development | test | production
APP_ENV=development

# --- Pruebas de integracion (pytest desde el host) ---
# PostgreSQL del compose publicado en 127.0.0.1:5432. La base DEBE terminar en "_test":
# las pruebas de migracion la vacian (downgrade base). La crean ellas si no existe.
TEST_DATABASE_URL=postgresql+psycopg://app_user:CAMBIAR_POR_CONTRASENA_LOCAL@127.0.0.1:5432/app_db_test

# --- Libros historicos (migracion inicial, CU-03) ---
# Carpeta local con los libros "Control Gym*.xlsx"; se monta en el backend como
# /data/historico de solo lectura. Ruta absoluta o relativa a compose.yaml.
# Solo se leen los *Control*Gym*.xlsx (se ignoran los ~$* y cualquier otro .xlsx, como la
# plantilla de carga). Obligatoria: sin ella `docker compose` no arranca.
HISTORICO_DIR=/RUTA/A/CARPETA/CON/LIBROS_HISTORICOS

# --- Puertos publicados en 127.0.0.1 (opcionales) ---
# Por defecto 5432/8000/8080. El stack e2e (.env.e2e.example) usa 5433/8001/8081.
# Si cambias FRONTEND_PORT, ajusta tambien CORS_ORIGINS.
# DB_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=8080
# Etiqueta de las imagenes backend/frontend (por defecto "dev"; el stack e2e usa "e2e").
# IMAGE_TAG=dev

# --- Acceso por IP (CU-00) y red interna de compose (opcionales) ---
# El backend solo atiende a estas IPs o rangos CIDR (separados por coma), salvo
# GET /api/v1/health. Dentro de Docker ve la IP fija del contenedor del frontend (nginx).
# Por defecto: 127.0.0.1,::1,<FRONTEND_IP>. Vacio o "*" es un error (nunca se abre a todos).
# Si defines una, define RED_INTERNA_SUBNET y FRONTEND_IP juntas (la IP dentro de la subred).
# Por defecto el stack principal usa 172.30.0.0/24 y el frontend 172.30.0.10.
# RED_INTERNA_SUBNET=172.30.0.0/24
# FRONTEND_IP=172.30.0.10
# IPS_PERMITIDAS=127.0.0.1,::1,172.30.0.10

# --- Reentrenamiento del modelo (CU-02, opcionales) ---
# Planificador dentro del backend: revisa al arrancar y cada hora la fecha programada.
# REENTRENAMIENTO_AUTOMATICO=true
# Criterios (por defecto 150 ciclos nuevos, 60 % de cobertura, 20 casos por clase, 3 meses
# de comparacion para la PR-AUC).
# REENTRENAR_MIN_CICLOS_NUEVOS=150
# REENTRENAR_MIN_COBERTURA_VENCIMIENTO=0.60
# REENTRENAR_MIN_CASOS_POR_CLASE=20
# REENTRENAR_MESES_COMPARACION=3
