{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": [
      "Documentation"
    ],
    "deny": [
      "Edit(Documentation/Plan/**)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout:*)",
      "Bash(docker compose down -v:*)",
      "Bash(dropdb:*)",
      "Bash(psql:*)",
      "Bash(alembic upgrade:*)",
      "Bash(alembic downgrade:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)",
      "Bash(lint-imports:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(alembic revision:*)",
      "Bash(alembic history:*)",
      "Bash(alembic current:*)",
      "Bash(npx playwright test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(graphify query:*)",
      "Bash(graphify path:*)",
      "Bash(graphify explain:*)",
      "Bash(graphify update:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commit.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
