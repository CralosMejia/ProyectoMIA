# Stack E2E aislado (proyecto de compose "mtabolic-e2e"): base, volumen, red e imagenes
# propios; libros historicos SINTETICOS. No toca el stack principal ni sus datos.
# Copiar a .env.e2e (no versionado) y reemplazar el marcador de contrasena por uno local
# de prueba (URL-safe, p. ej. hex; distinto del principal). Nunca valores reales aqui.
#
# Levantar:  docker compose -p mtabolic-e2e --env-file .env.e2e up -d --build
# Estado:    curl http://localhost:8001/api/v1/sistema/estado   (espera LISTO)
# App:       http://localhost:8081
# Bajar:     docker compose -p mtabolic-e2e --env-file .env.e2e down -v
#            (-v borra solo el volumen mtabolic-e2e_pgdata; SIEMPRE con -p mtabolic-e2e)
# Ojo: las variables exportadas en la shell ganan a --env-file. Lanza el stack e2e
# desde una shell SIN el .env principal cargado (sin `set -a; . ./.env`).

# --- PostgreSQL ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASENA_DE_PRUEBA
POSTGRES_DB=app_db_e2e

# --- Backend ---
DATABASE_URL=postgresql+psycopg://app_user:CAMBIAR_POR_CONTRASENA_DE_PRUEBA@db:5432/app_db_e2e
CORS_ORIGINS=http://localhost:8081
APP_ENV=development

# --- Libros historicos SINTETICOS (relativo a compose.yaml) ---
HISTORICO_DIR=./Backend/tests/fixtures/historico

# --- Puertos e imagenes propios del stack e2e ---
DB_PORT=5433
BACKEND_PORT=8001
FRONTEND_PORT=8081
IMAGE_TAG=e2e
