# Stack de demostracion (proyecto de compose "mtabolic-demo", R-019): base, volumen, red e
# imagenes propios y datos INVENTADOS de datos-demo/. No toca el stack principal ni el e2e.
#
# No hace falta copiar ni editar este archivo: scripts/levantar-demo.ps1 y levantar-demo.sh
# crean .env.demo (no versionado) con contrasenas aleatorias en lugar de los marcadores.
# Nunca pongas valores reales aqui.
#
# Levantar:  ver GUIA-RAPIDA.md
# App:       http://localhost:8083
# Parar:     docker compose -p mtabolic-demo --env-file .env.demo stop
# Borrar:    docker compose -p mtabolic-demo --env-file .env.demo down -v
#            (-v borra solo el volumen mtabolic-demo_pgdata; SIEMPRE con -p mtabolic-demo)
# Ojo: las variables exportadas en la shell ganan a --env-file. Los scripts las limpian; a mano,
# opera desde una shell sin el .env principal cargado.

# --- PostgreSQL ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_POSTGRES
POSTGRES_DB=app_db_demo

# --- Rol de la aplicacion sin superusuario (S23 activo; ver .env.example) ---
APP_DB_USER=mtabolic_app
APP_DB_PASSWORD=CAMBIAR_CONTRASENA_APP
MIGRATE_DATABASE_URL=postgresql+psycopg://app_user:CAMBIAR_CONTRASENA_POSTGRES@db:5432/app_db_demo

# --- Backend (con el rol de la aplicacion) ---
DATABASE_URL=postgresql+psycopg://mtabolic_app:CAMBIAR_CONTRASENA_APP@db:5432/app_db_demo
CORS_ORIGINS=http://localhost:8083
APP_ENV=development

# --- Libros historicos INVENTADOS (relativo a compose.yaml; carpeta versionada) ---
HISTORICO_DIR=./datos-demo

# --- Puertos e imagenes propios del stack demo ---
DB_PORT=5435
BACKEND_PORT=8003
FRONTEND_PORT=8083
IMAGE_TAG=demo

# --- Red interna e IPs permitidas (explicitas: no chocan con el principal ni con el e2e) ---
RED_INTERNA_SUBNET=172.29.0.0/24
FRONTEND_IP=172.29.0.10
IPS_PERMITIDAS=127.0.0.1,::1,172.29.0.10
